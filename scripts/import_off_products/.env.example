# Skopiuj jako .env i uzupełnij.

# Supabase (import do tabeli products w Supabase) – run.js
SUPABASE_URL=https://twoj-projekt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Turso (baza produktów – zalecane, duży darmowy limit) – run-turso.js
# URL: turso db show <nazwa-bazy> --http-url  |  Token: turso db tokens create <nazwa-bazy>
TURSO_DATABASE_URL=https://twoja-baza-org.turso.io
TURSO_AUTH_TOKEN=
